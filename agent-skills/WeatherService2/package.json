{
  "name": "weather-service",
  "version": "1.0.0",
  "description": "MCP server exposing a single tool that returns mock weather data for a city.",
  "type": "module",
  "main": "dist/server.js",
  "bin": {
    "weather-service": "dist/server.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "inspect": "npx @modelcontextprotocol/inspector npx tsx src/server.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
